# RDKit's SDF property headers contain trailing spaces. Preserve the exact
# serialized, checksummed molecular data instead of formatting it as code.
src/sarscope/data/field_example/*.sdf -whitespace
src/sarscope/data/field_ccr5_example/*.sdf -whitespace

# Preserve raw pytest tracebacks in the dated validation records.
benchmarks/field_qsar/ccr5-demo-tests-20261017.xml -whitespace
benchmarks/field_qsar/ccr5-offline-tests-bounded-20261017.xml -whitespace

# Matplotlib SVG paths contain trailing spaces. Keep the checksummed export
# byte-for-byte rather than reformatting frozen scientific evidence.
benchmarks/field_qsar/validation-20261018/held_out_predictions.svg -whitespace

# Paper-data manifests cover exact bytes, including valid CSV CRLF endings.
# Disable checkout EOL conversion so Windows/Linux copies keep the same hashes.
examples/paper_data/** -text
examples/paper_data/qsar3d/*.csv whitespace=cr-at-eol
